        },
        {
          "name": "Search User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/searchUser?keyword=John",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "searchUser"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "John"
                }
              ]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "firstName",
                  "value": "Jane",
                  "type": "text"
                },
                {
                  "key": "lastName",
                  "value": "Smith",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "jane.smith@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "newpassword123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/user/updateUser/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "updateUser",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "REPLACE_WITH_USER_ID"
                }
              ]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
